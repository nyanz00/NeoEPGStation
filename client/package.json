{
    "name": "epgstation-client",
    "version": "2.10.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run check && vite build",
        "check": "tsc --noEmit && prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\" index.html",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\" index.html",
        "dev": "vite",
        "preview": "vite preview"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/icons-material": "9.2.0",
        "@mui/material": "9.2.0",
        "@tanstack/react-query": "5.101.2",
        "axios": "1.18.1",
        "dplayer": "https://github.com/tsukumijima/DPlayer/archive/refs/tags/v1.32.8.tar.gz",
        "hls.js": "1.6.16",
        "jassub": "1.8.8",
        "mpegts.js": "https://github.com/tsukumijima/mpegts.js/archive/cc58169d2b61f0d27588fd31593b8739abe7b0ab.tar.gz",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-router-dom": "7.18.1",
        "socket.io-client": "4.8.3"
    },
    "devDependencies": {
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "prettier": "3.6.2",
        "typescript": "7.0.2",
        "vite": "8.1.4"
    },
    "overrides": {
        "path-parse": "1.0.7"
    }
}
