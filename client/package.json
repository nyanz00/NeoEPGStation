{
    "name": "neoepgstation-client",
    "version": "1.0.0-beta.3",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node ../scripts/run-package-scripts.cjs check && vite build",
        "check": "tsc --noEmit && prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\" index.html",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,ts}\" index.html",
        "dev": "vite",
        "preview": "vite preview"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/icons-material": "9.3.1",
        "@mui/material": "9.3.1",
        "@tanstack/react-query": "5.101.4",
        "axios": "1.19.0",
        "dplayer": "https://github.com/nyanz00/DPlayer/archive/412ef4ebc943f9df8c2a60f1ba31bd3301f8df1d.tar.gz",
        "hls.js": "1.6.17",
        "jassub": "1.8.8",
        "mpegts.js": "https://github.com/tsukumijima/mpegts.js/archive/cc58169d2b61f0d27588fd31593b8739abe7b0ab.tar.gz",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "7.18.2",
        "socket.io-client": "4.8.3"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "prettier": "3.9.6",
        "typescript": "7.0.2",
        "vite": "8.2.1"
    },
    "overrides": {
        "nanoid": "3.3.18",
        "path-parse": "1.0.7",
        "postcss": "8.5.26",
        "socket.io-parser": "4.2.7"
    }
}
