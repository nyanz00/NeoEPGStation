FROM node:24.18.0-bookworm AS server-deps
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
ENV DOCKER="YES"
RUN npm ci --loglevel=info

FROM server-deps AS server-builder
COPY . .
RUN npm run update-tsreadex \
    && node scripts/preflight.cjs build-server

FROM node:24.18.0-bookworm AS server-prod-deps
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
ENV DOCKER="YES"
RUN npm ci --omit=dev --loglevel=info \
    && npm cache clean --force

FROM --platform=$BUILDPLATFORM node:24.18.0-bookworm AS client-deps
WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci --loglevel=info

FROM client-deps AS client-builder
WORKDIR /app
COPY package.json ./
COPY api.d.ts ./
COPY src/util/AssCommentParser.ts src/util/AssCommentParser.ts
COPY scripts/preflight.cjs scripts/preflight-resources.cjs scripts/run-package-scripts.cjs scripts/
COPY client/ client/
RUN node scripts/preflight.cjs build-client

FROM node:24.18.0-bookworm-slim AS final
LABEL maintainer="l3tnun"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && ln -sf /usr/bin/ffmpeg /usr/local/bin/ffmpeg \
    && ln -sf /usr/bin/ffprobe /usr/local/bin/ffprobe \
    && rm -rf /var/lib/apt/lists/*
ENV NEOEPGSTATION_CONTAINER_RUNTIME=docker
WORKDIR /app
COPY --from=server-prod-deps /app/node_modules ./node_modules
COPY package.json ./
COPY --from=server-builder /app/config ./config
COPY --from=server-builder /app/api.yml /app/ormconfig.js ./
COPY --from=server-builder /app/img ./img
COPY --from=server-builder /app/licenses ./licenses
COPY --from=server-builder /app/dist ./dist
COPY --from=server-builder /app/scripts/preflight-resources.cjs ./scripts/preflight-resources.cjs
COPY --from=server-builder /app/thirdparty/tsreadex/ ./thirdparty/tsreadex/
COPY --from=client-builder /app/client/dist ./client/dist
EXPOSE 8888
ENTRYPOINT ["npm"]
CMD ["start"]
