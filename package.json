{
    "name": "epgstation",
    "version": "2.10.0",
    "description": "DTV Software in Japan.",
    "main": "dist/index.js",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
    },
    "scripts": {
        "all-install": "npm i --no-save && cd client && npm i --no-save",
        "start": "node dist/index.js",
        "build": "npm run build-server && npm run build-client",
        "build-server": "npm run lint && npm run format && npm run compile",
        "build-client": "cd client && npm run build",
        "lint": "eslint --fix --ext .ts src/",
        "format": "prettier --check --write src/**/*.ts",
        "compile": "tsc",
        "watch": "tsc --watch",
        "update-tsreadex": "powershell -ExecutionPolicy Bypass -File scripts/update-tsreadex.ps1",
        "orm-gen": "typeorm migration:generate src/db/migrations/${npm_config_db}/${npm_config_name} -d ./ormconfig.js",
        "orm-run": "typeorm migration:run -d ./ormconfig.js",
        "backup": "node dist/DBTools.js -m backup -o",
        "restore": "node dist/DBTools.js -m restore -o",
        "v1migrate": "node dist/V1MigrationTool.js -i",
        "install-win-service": "winser -i -a -n epgstation-nyanz --displayname epgstation-nyanz",
        "uninstall-win-service": "winser -r -x -n epgstation-nyanz",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/l3tnun/EPGStation-V2.git"
    },
    "author": "l3tnun",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/l3tnun/EPGStation-V2/issues"
    },
    "homepage": "https://github.com/l3tnun/EPGStation-V2#readme",
    "dependencies": {
        "arib-subtitle-timedmetadater": "4.0.10",
        "aribts": "2.1.12",
        "axios": "1.18.1",
        "better-sqlite3": "12.4.6",
        "body-parser": "1.20.5",
        "cors": "2.8.6",
        "diskusage-ng": "1.0.4",
        "eventsource": "2.0.2",
        "express": "4.22.2",
        "express-openapi": "12.1.3",
        "file-type": "16.5.4",
        "inversify": "6.0.2",
        "js-yaml": "5.2.0",
        "lodash": "4.18.1",
        "log4js": "6.9.1",
        "minimist": "1.2.8",
        "mirakurun": "3.9.0-rc.4",
        "mkdirp": "3.0.1",
        "multer": "2.2.0",
        "mysql2": "3.15.3",
        "openapi-types": "12.1.3",
        "reflect-metadata": "0.2.2",
        "socket.io": "4.8.3",
        "source-map-support": "0.5.21",
        "swagger-ui-dist": "5.32.8",
        "typeorm": "1.0.0",
        "url-join": "4.0.1"
    },
    "devDependencies": {
        "@types/body-parser": "1.19.5",
        "@types/eventsource": "1.1.15",
        "@types/express": "4.17.21",
        "@types/js-yaml": "4.0.9",
        "@types/lodash": "4.17.24",
        "@types/minimist": "1.2.5",
        "@types/mkdirp": "1.0.2",
        "@types/multer": "2.1.0",
        "@types/node": "18.11.9",
        "@types/socket.io": "3.0.1",
        "@types/source-map-support": "0.5.10",
        "@types/url-join": "4.0.3",
        "@typescript-eslint/eslint-plugin": "7.8.0",
        "@typescript-eslint/parser": "7.8.0",
        "eslint": "8.57.0",
        "eslint-config-prettier": "8.10.0",
        "prettier": "3.2.5",
        "typescript": "5.4.5",
        "winser": "1.0.3"
    },
    "overrides": {
        "@eslint/eslintrc": {
            "ajv": "6.15.0",
            "minimatch": "3.1.5"
        },
        "@humanwhocodes/config-array": {
            "minimatch": "3.1.5"
        },
        "eslint": {
            "ajv": "6.15.0",
            "minimatch": "3.1.5"
        },
        "flat-cache": {
            "flatted": "3.4.2"
        },
        "glob": {
            "minimatch": "3.1.5"
        },
        "jsonrpc2-ws": {
            "ws": "8.21.0"
        },
        "log4js": {
            "flatted": "3.4.2"
        },
        "minimatch@3.1.5": {
            "brace-expansion": "1.1.15"
        },
        "minimatch@9.0.4": {
            "brace-expansion": "2.1.1"
        },
        "mirakurun": {
            "express": "4.22.2",
            "morgan": "1.11.0",
            "semver": "7.8.5"
        },
        "node-abi": {
            "semver": "7.8.5"
        },
        "prebuild-install": {
            ".": "7.1.3",
            "tar-fs": "2.1.5"
        },
        "node-gyp": "12.4.0",
        "socket.io": {
            "socket.io-adapter": "2.5.8",
            "socket.io-parser": "4.2.6"
        },
        "socket.io-adapter": {
            "ws": "8.21.0"
        },
        "tar": "7.5.19"
    }
}
